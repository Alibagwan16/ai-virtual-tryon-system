# Rename this file to ".env" (same folder as app.py) and fill in your key.
# Get a free key from: https://aistudio.google.com/apikey
#
# This file is loaded on the SERVER/BACKEND only — the key is never shown
# or editable from the app's UI.

GEMINI_API_KEY=your_gemini_api_key_here

# Optional — override the default model:
# GEMINI_MODEL=gemini-2.5-flash-image

# Optional — max simultaneous Gemini calls in flight at once, across all
# shops. Extra requests wait in a queue instead of all hitting the API at
# once and triggering rate-limit errors. Default: 3.
# MAX_CONCURRENT_GENERATIONS=3

# Optional — organization-wide daily cap on generations, across ALL shops
# combined (protects your total budget even if every shop stays under its
# own individual daily_limit). 0 = unlimited (default).
# MAX_DAILY_GENERATIONS=0

# Optional — set to true to show full tracebacks in the app for debugging:
# TRYON_DEBUG=false

# --------------------------------------------------------------------------
# Pay-as-you-go credits (optional — leave OWNER_UPI_ID blank to hide this
# feature entirely). Once set, shops can buy credits from the sidebar via
# a UPI QR code that pays directly into YOUR UPI account. See credits.py
# for how the manual-approval flow works — a plain UPI QR can't auto-notify
# the app when payment succeeds, so you verify the payment yourself and
# approve it from the Admin Dashboard, which then credits their balance.
# --------------------------------------------------------------------------

# Your UPI ID that payments should go to, e.g. "yourname@okhdfcbank"
# OWNER_UPI_ID=

# Name shown to the payer in their UPI app (optional, cosmetic only):
# OWNER_UPI_NAME=AI Try-On Studio

# Price per credit in rupees. 1 credit = 1 generation, spent automatically
# once a shop's free daily quota runs out. Default: 15
# Just a plain number — no "rs", "₹", or any other text/symbol.
# PRICE_PER_CREDIT=15

# --------------------------------------------------------------------------
# Persistent storage via Google Sheets (strongly recommended once you have
# real shops signing up). WHY: Streamlit Cloud rebuilds the server fresh
# from your GitHub repo on every redeploy — self-signups, credit purchases,
# and usage counters that only ever live in a local JSON file on the OLD
# server are lost when that happens. A Google Sheet lives completely
# outside GitHub/Streamlit Cloud, so it survives redeploys untouched.
#
# Leave this whole section blank to keep using local JSON files exactly as
# before (fine for local testing) — see README.md for the full setup guide
# (creating a Google Cloud service account + Sheet, sharing it, getting the
# key). Once both GOOGLE_SHEET_ID and the service account key are set, shop
# signups / credits / usage automatically switch to using the Sheet.
# --------------------------------------------------------------------------

# The Sheet's ID — the long ID in its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
# GOOGLE_SHEET_ID=

# The service account's JSON key, as ONE line of JSON (paste the whole
# downloaded .json file's content here, all on one line). On Streamlit
# Community Cloud, put this under [gcp_service_account] in your app's
# "Secrets" settings instead (TOML format) — see README.md.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
