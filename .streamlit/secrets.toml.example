# If you deploy this app to Streamlit Community Cloud, copy this file to
# ".streamlit/secrets.toml" (do NOT commit that file) and paste your key
# in the app's "Settings -> Secrets" panel instead, using this same format.
#
# Locally, .env is enough — you don't need this file on your own machine.

GEMINI_API_KEY = "your_gemini_api_key_here"

# Optional — pay-as-you-go credits (see .env.example for details):
# OWNER_UPI_ID = "yourname@okhdfcbank"
# OWNER_UPI_NAME = "AI Try-On Studio"
# PRICE_PER_CREDIT = 15

# Optional but STRONGLY recommended once real shops are signing up — makes
# shop signups / credits / usage survive redeploys instead of being wiped
# every time you push new code. See README.md for how to create this
# service account + Sheet. GOOGLE_SHEET_ID goes in .env as normal (it's not
# a secret); only the service account key goes here.
# GOOGLE_SHEET_ID = "paste_the_sheet_id_from_its_url_here"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project-id"
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
# (copy every one of these fields straight out of the JSON key file Google
# gives you when you create the service account — same field names, just
# TOML syntax instead of JSON)
